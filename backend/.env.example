# --- AI (the one paid dependency) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_GENERATION_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_EMBEDDING_DIM=768

# --- Database (Local PostgreSQL or Supabase) ---
# For Local Docker: postgresql+asyncpg://samai:samai@db:5432/samai
# For Supabase (Direct): postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# For Supabase (Pooler): postgresql+asyncpg://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://samai:samai@db:5432/samai
DATABASE_URL_SYNC=postgresql+psycopg2://samai:samai@db:5432/samai


# --- Redis (cache + Celery broker/backend) ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage (swap provider with one env var) ---
STORAGE_PROVIDER=local          # local | r2 | s3
STORAGE_LOCAL_PATH=/app/uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=samai-documents
R2_ENDPOINT_URL=

# --- Email / OTP (cost-effective: any SMTP works, incl. free tiers) ---
# Gmail: use an App Password, not your normal password.
# Free alternatives with generous free tiers: Brevo, Mailjet, Resend, Zoho Mail.
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your_email@gmail.com
MAIL_FROM_NAME=SamAI
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
OTP_EXPIRE_SECONDS=300
OTP_LENGTH=6

# --- App ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
